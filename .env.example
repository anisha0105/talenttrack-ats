# ==============================================================================
# TalentTrack ATS - Environment Configuration Template
# Copy this file to '.env' and populate with your authorized credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=talenttrack
POSTGRES_USER=talenttrack
POSTGRES_PASSWORD=replace_with_secure_password

# Authentication & Security
# Required: Provide a cryptographically secure key of at least 32 characters (256 bits).
# E.g., generate via: openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_characters_secret_key

# Application Settings
PORT=8080
CORS_ORIGIN=http://localhost:3000
ELASTICSEARCH_ENABLED=false
SEED_DEMO=false

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
